{
  "_README": "Copiază acest fișier ca 'appsettings.json' în același folder și completează valorile tale locale. appsettings.json este în .gitignore, deci nu se urcă niciodată în git.",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=RBooking;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Issuer": "RBookingAPI",
    "Audience": "RBookingClient",
    "Key": "CHANGE_ME_orice_string_lung_si_secret_pentru_semnat_JWT"
  },
  "Security": {
    "ApiKey": "CHANGE_ME_cheia_ceruta_de_ApiKeyMiddleware_pe_orice_request"
  },
  "Webhooks": {
    "_comment": "Trebuie sa coincida EXACT cu Webhooks:Secret din RBooking.WebhookAPI/appsettings.json - e cheia HMAC folosita ca sa semnezi/verifici webhook-ul de accommodation-updated.",
    "AccommodationUpdatedUrl": "http://localhost:5310/api/webhooks/accommodation-updated",
    "ApiBReviewWebhookUrl": "http://localhost:5294/api/webhooks/reviews",
    "Secret": "CHANGE_ME_acelasi_secret_ca_in_WebhookAPI"
  },
  "Smtp": {
    "_comment": "Optional - daca Host ramane gol, email-urile (ex: confirmare rezervare) nu se trimit efectiv, doar se loghează în consolă.",
    "Host": "",
    "Port": "587",
    "User": "",
    "Password": "",
    "From": "",
    "EnableSsl": "true"
  }
}
